{
  "compilerOptions": {
    "composite": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable", "WebWorker"],
    "strict": true,
    "noUnusedLocals": false,
    "skipLibCheck": true,
    "jsx": "preserve",
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "allowSyntheticDefaultImports": true,
    "baseUrl": ".",
    "paths": {
      "@shared/*": ["packages/shared/*"],
      "@graph-core/*": ["packages/graph-core/*"],
      "@renderer/*": ["apps/desktop/src/renderer/src/*"]
    }
  },
  "include": [
    "apps/desktop/src/renderer/src/**/*.ts",
    "apps/desktop/src/renderer/src/**/*.d.ts",
    "apps/desktop/src/renderer/src/**/*.vue",
    "packages/shared/**/*.ts",
    "packages/graph-core/**/*.ts"
  ]
}
