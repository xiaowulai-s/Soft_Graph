    {
      "id": "GC-15",
      "name": "AI 模型库盘点",
      "description": "Ollama / LM Studio 本地模型文件盘点（仅提示占用，不自动清理——是否删除由用户决定）",
      "risk": "hint",
      "defaultSelected": false,
      "algorithm": "bigfile",
      "match": {
        "roots": [
          "%USERPROFILE%\\.ollama\\models",
          "%USERPROFILE%\\.lmstudio\\models",
          "%USERPROFILE%\\.ollama\\models\\blobs"
        ],
        "patterns": [
          "*"
        ],
        "minSizeBytes": 52428800,
        "maxDepth": 8
      },
      "options": {
        "topN": 100
      }
